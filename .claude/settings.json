{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)", "Bash(cargo check:*)", "Bash(cargo clippy:*)", "Bash(cargo test:*)", "Bash(cargo build:*)", "Bash(cargo tree:*)",
      "Bash(uv run ruff:*)", "Bash(uv run mypy:*)", "Bash(uv run pytest:*)", "Bash(uv sync:*)",
      "Bash(pnpm lint:*)", "Bash(pnpm typecheck:*)", "Bash(pnpm test:*)", "Bash(pnpm -C apps/web:*)",
      "Bash(just contracts-gen:*)", "Bash(just contracts-test:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)", "Bash(git add:*)", "Bash(git commit:*)"
    ],
    "ask": [
      "Bash(cargo add:*)", "Bash(uv add:*)", "Bash(pnpm add:*)", "Bash(npm install:*)",
      "Bash(git push:*)", "Bash(git reset:*)", "Bash(git rebase:*)"
    ],
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(./**/secrets/**)", "Read(./**/*.pem)", "Read(./**/*.key)",
      "Bash(rm -rf:*)", "Bash(git push --force:*)", "Bash(curl:*)", "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-paths.sh" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-rules.sh" }
        ]
      }
    ]
  }
}
