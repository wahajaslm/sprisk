{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprisk.dev/schemas/bundle.schema.json",
  "$comment": "Generated by contracts/tools/bundle.py. Do not edit.",
  "title": "Bundle",
  "$defs": {
    "CreateRun": {
      "title": "CreateRun",
      "description": "Request body for POST /runs: run a pipeline version that already passed Gate A.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version_id"
      ],
      "properties": {
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId"
        },
        "reuse_run_id": {
          "$ref": "#/$defs/RunId",
          "description": "Reuse this run's results for every step whose definition is unchanged; run the rest (ADR-0026). Omitted: run from the start."
        }
      }
    },
    "AttemptOutput": {
      "title": "AttemptOutput",
      "description": "One committed output of an attempt: the port that produced it and the artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "artifact"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/PortName"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      }
    },
    "Problem": {
      "title": "Problem",
      "description": "Error response body. Lists every problem found, not only the first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Error"
          }
        }
      }
    },
    "TablePage": {
      "title": "TablePage",
      "description": "One page of rows from a tabular artifact, for display (GET /artifacts/{id}/rows). Cells are display text, cut to a bounded length; a missing cell is listed by column index and its text is empty. Wide tables return only their first columns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "total_rows",
        "total_columns",
        "columns",
        "rows"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the first row in this page."
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total_columns": {
          "type": "integer",
          "minimum": 0,
          "description": "Columns in the table; more than `columns` holds when the table is too wide to page whole."
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableRow"
          }
        }
      }
    },
    "TableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "type": "string",
          "description": "Arrow data type name, for display only."
        }
      }
    },
    "TableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "missing"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Indexes of columns whose value is missing in this row."
        }
      }
    },
    "OperatorSource": {
      "title": "OperatorSource",
      "description": "Read-only source of a registered operator's entrypoint module, so every step's code can be read like a code step's. Served by GET /operators/{id}/source; the API reads only files inside the operator's plugin pack.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator",
        "path",
        "language",
        "text",
        "digest"
      ],
      "properties": {
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "path": {
          "type": "string",
          "description": "Relative to the pack's src/, e.g. sprisk_clean/impute.py. Never an absolute path."
        },
        "language": {
          "type": "string",
          "enum": [
            "python"
          ]
        },
        "text": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/ContentHash",
          "description": "The operator's implementation digest: the code that runs, and the code shown, are the same."
        }
      }
    },
    "FigureSet": {
      "title": "FigureSet",
      "description": "Figures a step drew (ADR-0024), converted by the worker: matplotlib as SVG text, Plotly as its figure JSON text.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Figure"
          }
        }
      }
    },
    "Figure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "library",
        "format",
        "content"
      ],
      "properties": {
        "library": {
          "type": "string",
          "enum": [
            "matplotlib",
            "plotly"
          ]
        },
        "format": {
          "type": "string",
          "enum": [
            "svg",
            "plotly_json"
          ]
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string",
          "description": "SVG markup, or a Plotly figure as JSON text."
        }
      }
    },
    "CodeDisplay": {
      "title": "CodeDisplay",
      "description": "What a code step showed (ADR-0020): printed text, tables and images, in order. Written by the worker as the step's display artifact; every part is capped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisplayItem"
          }
        }
      }
    },
    "DisplayItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "table",
            "image"
          ]
        },
        "text": {
          "type": "string",
          "description": "Present for kind text."
        },
        "table": {
          "$ref": "#/$defs/TablePage",
          "description": "Present for kind table: the first rows only."
        },
        "png_base64": {
          "type": "string",
          "description": "Present for kind image: a PNG, base64-encoded."
        },
        "channel": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ],
          "description": "For printed text: which stream it came from. Absent for displayed values. Warnings arrive on stderr."
        }
      }
    },
    "CodeInterface": {
      "title": "CodeInterface",
      "description": "What a code step's run found about its interface (ADR-0021): names it reads, literal settings it could expose, and values it ends with. Suggestions, not a claim that arbitrary code is understood.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "parameters",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeInput"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeParameter"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeOutputCandidate"
          }
        },
        "files": {
          "type": "array",
          "description": "Files the code reads (ADR-0025): inputs, never parameters. Omitted in reports written before ADR-0025.",
          "items": {
            "$ref": "#/$defs/CodeFileRead"
          }
        }
      }
    },
    "CodeFileRead": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "reader",
        "line"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "reader": {
          "type": "string",
          "description": "The call that reads it, e.g. read_csv or open."
        },
        "line": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "CodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "origin",
        "bound"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "bound": {
          "type": "boolean",
          "description": "True when the name is provided by the step (its input table or a library); false means the code reads a name nothing defines."
        }
      }
    },
    "CodeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "line",
        "value_type",
        "default_text",
        "effective_text",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "value_type": {
          "type": "string",
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "default_text": {
          "type": "string",
          "description": "The literal as written in the source."
        },
        "effective_text": {
          "type": "string",
          "description": "The literal the run used, as Python source."
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "inferred until the user exposes it (confirmed)."
        }
      }
    },
    "CodeOutputCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "origin",
        "chosen"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Python type of the final value, e.g. polars.DataFrame."
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "chosen": {
          "type": "boolean",
          "description": "This value became the step's data output."
        },
        "fields": {
          "type": "array",
          "description": "For tables: their columns with type and missing count, for the Data tab's variable explorer (ADR-0030). Capped.",
          "items": {
            "$ref": "#/$defs/CodeField"
          }
        },
        "sample": {
          "$ref": "#/$defs/TablePage",
          "description": "For tables: the first rows (ADR-0030). Omitted once the report's size budget is used up."
        },
        "text": {
          "type": "string",
          "description": "For other values: their repr, cut to a bounded length (ADR-0030)."
        }
      }
    },
    "CodeSplitRequest": {
      "title": "CodeSplitRequest",
      "description": "Notebook cells to split into code steps (ADR-0031), in notebook order. Body of POST /code/split. Never executed.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cells"
      ],
      "properties": {
        "cells": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100000
          }
        }
      }
    },
    "CodeSplit": {
      "title": "CodeSplit",
      "description": "Code steps read from notebook cells (ADR-0031): each step's source, the cells it holds and the tables it reads and passes on, the links between steps, and notes for the person. A suggestion they confirm before a flow is made.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps",
        "links",
        "notes"
      ],
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SplitStep"
          }
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SplitLink"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SplitNote"
          }
        }
      }
    },
    "SplitStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "cells",
        "inputs",
        "outputs"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "The step's code: its cells, with the imports and literals it uses from earlier cells copied in."
        },
        "cells": {
          "type": "array",
          "description": "Indexes (from 0) of the cells this step holds.",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortName"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortName"
          }
        }
      }
    },
    "SplitLink": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from_step",
        "to_step",
        "name"
      ],
      "properties": {
        "from_step": {
          "type": "integer",
          "minimum": 0
        },
        "to_step": {
          "type": "integer",
          "minimum": 0
        },
        "name": {
          "$ref": "#/$defs/PortName"
        }
      }
    },
    "SplitNote": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "message"
      ],
      "properties": {
        "cell": {
          "type": "integer",
          "minimum": 0,
          "description": "Index (from 0) of the cell the note is about."
        },
        "message": {
          "type": "string"
        }
      }
    },
    "CodeField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type",
        "null_count"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "type": "string",
          "description": "Polars data type name, for display only."
        },
        "null_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Artifact": {
      "title": "Artifact",
      "description": "Immutable, content-addressed output of a step attempt (arch doc §4, §10).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "project_id",
        "producer_attempt_id",
        "content_hash",
        "media_type",
        "size_bytes",
        "uri",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.artifact/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "producer_attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$",
          "description": "IANA media type of the stored bytes."
        },
        "schema_ref": {
          "$ref": "#/$defs/SchemaId",
          "description": "Declared data schema. Absent for artifacts without a tabular schema, such as model bundles."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://.+$",
          "description": "Storage location. Opaque to domain logic; resolved by the artifact store."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SchemaId": {
      "type": "string",
      "pattern": "^sch_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "UTC, whole seconds, Z suffix. One canonical form so every language round-trips it unchanged. Pattern only: typify ignores pattern when format is set."
    },
    "InvestigationId": {
      "type": "string",
      "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "QuestionVersionId": {
      "type": "string",
      "pattern": "^qv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PipelineVersionId": {
      "type": "string",
      "pattern": "^plv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkerId": {
      "type": "string",
      "pattern": "^wrk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "NodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "Node name, unique within a pipeline version."
    },
    "PortName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "OperatorRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Pinned operator: dotted name @ semver, e.g. sprisk.eval.binary_classification@1.0.0."
    },
    "Params": {
      "type": "object",
      "description": "Operator parameters. Validated against the operator's params_schema by the compiler, not here.",
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "MethodologyCheck": {
      "title": "MethodologyCheck",
      "description": "Result of one Gate B methodology rule on one pipeline version (arch doc §4, §8). Immutable; re-checking creates a new record.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "pipeline_version_id",
        "check",
        "verdict",
        "rationale",
        "cited_nodes",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.methodology_check/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/MethodologyCheckId"
        },
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId"
        },
        "check": {
          "$ref": "#/$defs/CheckRef"
        },
        "verdict": {
          "$ref": "#/$defs/Verdict"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "cited_nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NodeId"
          },
          "description": "Nodes the verdict is about. Empty when the rule found nothing to inspect."
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "description": "What the rule could not assess. Omitted when there is nothing to say."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "MethodologyCheckId": {
      "type": "string",
      "pattern": "^mck_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CheckRef": {
      "type": "string",
      "description": "Pinned rule: <pack>.<rule>@<semver>.",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Verdict": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "warning",
        "not_assessed"
      ]
    },
    "Operator": {
      "title": "Operator",
      "description": "Registered, versioned capability that a pipeline node runs (arch doc §5, §6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "capability_class",
        "entrypoint",
        "inputs",
        "outputs",
        "params_schema",
        "effects",
        "network",
        "resources"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.operator/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/OperatorRef"
        },
        "capability_class": {
          "$ref": "#/$defs/CapabilityClass"
        },
        "description": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*:[a-z_][a-z0-9_]*$",
          "description": "Python `module:function` the worker calls."
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "params_schema": {
          "type": "object",
          "description": "JSON Schema for this operator's params. The compiler validates node params against it.",
          "additionalProperties": true
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "network": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        }
      }
    },
    "CapabilityClass": {
      "type": "string",
      "enum": [
        "source",
        "transform",
        "analyzer",
        "estimator",
        "evaluator",
        "optimizer",
        "decision_evaluator",
        "sink",
        "custom_code"
      ]
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/PortName"
        },
        "kind": {
          "$ref": "#/$defs/PortKind"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "PortKind": {
      "type": "string",
      "enum": [
        "table",
        "model",
        "metrics",
        "diagnostics",
        "report",
        "figure"
      ]
    },
    "Effects": {
      "type": "string",
      "enum": [
        "pure",
        "nondeterministic",
        "side_effecting"
      ],
      "description": "pure: same inputs give same outputs, cacheable. nondeterministic: not replayable. side_effecting: changes the outside world; never auto-retried."
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "none",
        "egress_allowlisted"
      ]
    },
    "Resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "memory_mb",
        "gpu",
        "timeout_seconds"
      ],
      "properties": {
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "gpu": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "PipelineVersion": {
      "title": "PipelineVersion",
      "description": "Immutable typed graph of pinned operators (arch doc §4, §5). Structural checks (at least one node, unique node ids, known ports, no cycles) belong to the Rust compiler, not this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "project_id",
        "nodes",
        "edges",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.pipeline_version/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/PipelineVersionId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "parent_id": {
          "$ref": "#/$defs/PipelineVersionId",
          "description": "Version this one was derived from. Absent for the first version."
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "params"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "params": {
          "$ref": "#/$defs/Params"
        },
        "code": {
          "$ref": "#/$defs/NodeCode",
          "description": "This step's own code in this version, replacing its operator's implementation (ADR-0028). Omitted: the operator's code runs."
        }
      }
    },
    "NodeCode": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "function"
      ],
      "properties": {
        "source": {
          "type": "string",
          "maxLength": 200000,
          "description": "Python module source."
        },
        "function": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "description": "The function in source that is the step."
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/PortRef"
        },
        "to": {
          "$ref": "#/$defs/PortRef"
        }
      }
    },
    "PortRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$",
      "description": "`<node_id>.<port_name>`."
    },
    "QuestionVersion": {
      "title": "QuestionVersion",
      "description": "Immutable formal statement of what an investigation asks (arch doc §4, §7). Every field records its origin. An absent target means no supervised target exists; never invent one.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "investigation_id",
        "objective",
        "task",
        "assumptions",
        "unknowns",
        "acceptance_criteria",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.question_version/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/QuestionVersionId"
        },
        "investigation_id": {
          "$ref": "#/$defs/InvestigationId"
        },
        "parent_id": {
          "$ref": "#/$defs/QuestionVersionId",
          "description": "Version this one revises. Absent for the first version."
        },
        "objective": {
          "$ref": "#/$defs/Fact"
        },
        "task": {
          "$ref": "#/$defs/TaskFact"
        },
        "target": {
          "$ref": "#/$defs/Fact",
          "description": "Target column. Absent when there is no legitimate supervised target."
        },
        "unit_of_analysis": {
          "$ref": "#/$defs/Fact"
        },
        "time_column": {
          "$ref": "#/$defs/Fact"
        },
        "assumptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "unknowns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unknown"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Fact"
          }
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Origin": {
      "type": "string",
      "enum": [
        "explicit",
        "inferred",
        "measured",
        "confirmed"
      ],
      "description": "explicit: user stated it. inferred: AI or rule guessed it. measured: computed from data. confirmed: user approved an inferred value."
    },
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "origin"
      ],
      "properties": {
        "value": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      }
    },
    "TaskFact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "origin"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/TaskType"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        }
      }
    },
    "TaskType": {
      "type": "string",
      "enum": [
        "exploration",
        "classification",
        "regression",
        "undetermined"
      ]
    },
    "Unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "question",
        "blocks"
      ],
      "properties": {
        "question": {
          "type": "string",
          "minLength": 1
        },
        "blocks": {
          "type": "string",
          "enum": [
            "planning",
            "execution",
            "release"
          ],
          "description": "Earliest stage this unknown must be resolved before."
        }
      }
    },
    "Run": {
      "title": "Run",
      "description": "One execution of a pipeline version against its inputs (arch doc §4, §9). Status is the transactionally maintained current state; history lives in attempts and audit events.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "project_id",
        "pipeline_version_id",
        "status",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.run/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/RunId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId"
        },
        "status": {
          "$ref": "#/$defs/RunStatus"
        },
        "reuse_run_id": {
          "$ref": "#/$defs/RunId",
          "description": "The run whose unchanged results this run reused (ADR-0026). Omitted when it ran from the start."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        },
        "finished_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Set once the run reaches a terminal status."
        }
      }
    },
    "RunStatus": {
      "type": "string",
      "enum": [
        "queued",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ]
    },
    "Attempt": {
      "title": "Attempt",
      "description": "One try of one step (a node in a run). Retries create a new attempt with the next number; old attempts are never replaced (arch doc §9).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "run_id",
        "node_id",
        "number",
        "state",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.attempt/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/AttemptId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "number": {
          "type": "integer",
          "minimum": 1,
          "description": "1 for the first try of this step."
        },
        "state": {
          "$ref": "#/$defs/AttemptState"
        },
        "worker_id": {
          "$ref": "#/$defs/WorkerId",
          "description": "Set once leased."
        },
        "lease_expires_at": {
          "$ref": "#/$defs/Timestamp",
          "description": "Set while leased."
        },
        "error": {
          "$ref": "#/$defs/Error",
          "description": "Set when state is failed or timed_out."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "AttemptState": {
      "type": "string",
      "enum": [
        "created",
        "validated",
        "queued",
        "leased",
        "running",
        "uploading",
        "succeeded",
        "failed",
        "cancelled",
        "timed_out",
        "skipped",
        "cache_hit"
      ]
    },
    "WorkerMessage": {
      "title": "WorkerMessage",
      "description": "Local worker protocol message (arch doc §11). Tagged by `type`.",
      "oneOf": [
        {
          "$ref": "#/$defs/Handshake"
        },
        {
          "$ref": "#/$defs/LeaseAttempt"
        },
        {
          "$ref": "#/$defs/Heartbeat"
        },
        {
          "$ref": "#/$defs/Progress"
        },
        {
          "$ref": "#/$defs/ArtifactManifest"
        },
        {
          "$ref": "#/$defs/Complete"
        },
        {
          "$ref": "#/$defs/Fail"
        },
        {
          "$ref": "#/$defs/Cancel"
        },
        {
          "$ref": "#/$defs/Acknowledge"
        }
      ]
    },
    "Handshake": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane, first message. Declares protocol version and operators the worker can run.",
      "required": [
        "type",
        "protocol_version",
        "worker_id",
        "operators"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "handshake"
          ]
        },
        "protocol_version": {
          "type": "string",
          "enum": [
            "sprisk.worker/v1"
          ]
        },
        "worker_id": {
          "$ref": "#/$defs/WorkerId"
        },
        "operators": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperatorRef"
          }
        }
      }
    },
    "LeaseAttempt": {
      "type": "object",
      "additionalProperties": false,
      "description": "Control plane → worker. Grants one attempt until lease_expires_at. Inputs are artifact references, never data.",
      "required": [
        "type",
        "attempt_id",
        "run_id",
        "node_id",
        "operator",
        "params",
        "inputs",
        "staging_uri",
        "lease_expires_at"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "lease_attempt"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "run_id": {
          "$ref": "#/$defs/RunId"
        },
        "node_id": {
          "$ref": "#/$defs/NodeId"
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "params": {
          "$ref": "#/$defs/Params"
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InputBinding"
          }
        },
        "code": {
          "$ref": "#/$defs/NodeCode",
          "description": "The step's own code (ADR-0028): run this function instead of the operator's."
        },
        "staging_uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://.+$",
          "description": "Only location the worker may write outputs to. Scoped to this attempt."
        },
        "lease_expires_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Heartbeat": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane. Extends the lease.",
      "required": [
        "type",
        "attempt_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "heartbeat"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        }
      }
    },
    "Progress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane. Informational only; never authoritative.",
      "required": [
        "type",
        "attempt_id",
        "completed",
        "total"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "progress"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "completed": {
          "type": "integer",
          "minimum": 0
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "ArtifactManifest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane. One output written to staging. The control plane verifies and commits it.",
      "required": [
        "type",
        "attempt_id",
        "port",
        "staging_uri",
        "content_hash",
        "media_type",
        "size_bytes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "artifact_manifest"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "port": {
          "$ref": "#/$defs/PortName"
        },
        "staging_uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://.+$"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$"
        },
        "schema_ref": {
          "$ref": "#/$defs/SchemaId"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "Complete": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane. All manifests sent; attempt finished.",
      "required": [
        "type",
        "attempt_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "complete"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        }
      }
    },
    "Fail": {
      "type": "object",
      "additionalProperties": false,
      "description": "Worker → control plane. Attempt failed. failure_kind guides retry policy; side-effecting operators are never auto-retried.",
      "required": [
        "type",
        "attempt_id",
        "error",
        "failure_kind"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "fail"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "error": {
          "$ref": "#/$defs/Error"
        },
        "failure_kind": {
          "type": "string",
          "enum": [
            "transient",
            "permanent"
          ]
        }
      }
    },
    "Cancel": {
      "type": "object",
      "additionalProperties": false,
      "description": "Control plane → worker. Stop the attempt.",
      "required": [
        "type",
        "attempt_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "cancel"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        }
      }
    },
    "Acknowledge": {
      "type": "object",
      "additionalProperties": false,
      "description": "Control plane → worker. Last message for this attempt was committed.",
      "required": [
        "type",
        "attempt_id"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "acknowledge"
          ]
        },
        "attempt_id": {
          "$ref": "#/$defs/AttemptId"
        }
      }
    },
    "InputBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "artifact_id",
        "uri",
        "content_hash"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/PortName"
        },
        "artifact_id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://.+$"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        }
      },
      "description": "Committed input artifact, resolved by the control plane. Read-only. The worker verifies content_hash before use."
    }
  }
}
