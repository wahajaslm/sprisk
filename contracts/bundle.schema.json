{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprisk.dev/schemas/bundle.schema.json",
  "$comment": "Generated by contracts/tools/bundle.py. Do not edit.",
  "title": "Bundle",
  "$defs": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "Artifact": {
      "title": "Artifact",
      "description": "Immutable, content-addressed output of a step attempt (arch doc §4, §10).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "project_id",
        "producer_attempt_id",
        "content_hash",
        "media_type",
        "size_bytes",
        "uri",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.artifact/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/ArtifactId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "producer_attempt_id": {
          "$ref": "#/$defs/AttemptId"
        },
        "content_hash": {
          "$ref": "#/$defs/ContentHash"
        },
        "media_type": {
          "type": "string",
          "pattern": "^[a-z]+/[a-z0-9.+-]+$",
          "description": "IANA media type of the stored bytes."
        },
        "schema_ref": {
          "$ref": "#/$defs/SchemaId",
          "description": "Declared data schema. Absent for artifacts without a tabular schema, such as model bundles."
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "uri": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9+.-]*://.+$",
          "description": "Storage location. Opaque to domain logic; resolved by the artifact store."
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SchemaId": {
      "type": "string",
      "pattern": "^sch_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
      "description": "UTC, whole seconds, Z suffix. One canonical form so every language round-trips it unchanged. Pattern only: typify ignores pattern when format is set."
    },
    "InvestigationId": {
      "type": "string",
      "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "QuestionVersionId": {
      "type": "string",
      "pattern": "^qv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PipelineVersionId": {
      "type": "string",
      "pattern": "^plv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkerId": {
      "type": "string",
      "pattern": "^wrk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "NodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "Node name, unique within a pipeline version."
    },
    "PortName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "OperatorRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$",
      "description": "Pinned operator: dotted name @ semver, e.g. sprisk.eval.binary_classification@1.0.0."
    },
    "Params": {
      "type": "object",
      "description": "Operator parameters. Validated against the operator's params_schema by the compiler, not here.",
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "Operator": {
      "title": "Operator",
      "description": "Registered, versioned capability that a pipeline node runs (arch doc §5, §6).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "capability_class",
        "entrypoint",
        "inputs",
        "outputs",
        "params_schema",
        "effects",
        "network",
        "resources"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.operator/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/OperatorRef"
        },
        "capability_class": {
          "$ref": "#/$defs/CapabilityClass"
        },
        "description": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*(\\.[a-z_][a-z0-9_]*)*:[a-z_][a-z0-9_]*$",
          "description": "Python `module:function` the worker calls."
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Port"
          }
        },
        "params_schema": {
          "type": "object",
          "description": "JSON Schema for this operator's params. The compiler validates node params against it.",
          "additionalProperties": true
        },
        "effects": {
          "$ref": "#/$defs/Effects"
        },
        "network": {
          "$ref": "#/$defs/NetworkAccess"
        },
        "resources": {
          "$ref": "#/$defs/Resources"
        }
      }
    },
    "CapabilityClass": {
      "type": "string",
      "enum": [
        "source",
        "transform",
        "analyzer",
        "estimator",
        "evaluator",
        "optimizer",
        "decision_evaluator",
        "sink",
        "custom_code"
      ]
    },
    "Port": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/PortName"
        },
        "kind": {
          "$ref": "#/$defs/PortKind"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "PortKind": {
      "type": "string",
      "enum": [
        "table",
        "model",
        "metrics",
        "diagnostics",
        "report"
      ]
    },
    "Effects": {
      "type": "string",
      "enum": [
        "pure",
        "nondeterministic",
        "side_effecting"
      ],
      "description": "pure: same inputs give same outputs, cacheable. nondeterministic: not replayable. side_effecting: changes the outside world; never auto-retried."
    },
    "NetworkAccess": {
      "type": "string",
      "enum": [
        "none",
        "egress_allowlisted"
      ]
    },
    "Resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cpu_cores",
        "memory_mb",
        "gpu",
        "timeout_seconds"
      ],
      "properties": {
        "cpu_cores": {
          "type": "integer",
          "minimum": 1
        },
        "memory_mb": {
          "type": "integer",
          "minimum": 1
        },
        "gpu": {
          "type": "string",
          "enum": [
            "none",
            "optional",
            "required"
          ]
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "PipelineVersion": {
      "title": "PipelineVersion",
      "description": "Immutable typed graph of pinned operators (arch doc §4, §5). Structural checks (at least one node, unique node ids, known ports, no cycles) belong to the Rust compiler, not this schema.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "project_id",
        "nodes",
        "edges",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.pipeline_version/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/PipelineVersionId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "parent_id": {
          "$ref": "#/$defs/PipelineVersionId",
          "description": "Version this one was derived from. Absent for the first version."
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Node"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Edge"
          }
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "Node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "params"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NodeId"
        },
        "operator": {
          "$ref": "#/$defs/OperatorRef"
        },
        "params": {
          "$ref": "#/$defs/Params"
        }
      }
    },
    "Edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/PortRef"
        },
        "to": {
          "$ref": "#/$defs/PortRef"
        }
      }
    },
    "PortRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}\\.[a-z][a-z0-9_]{0,62}$",
      "description": "`<node_id>.<port_name>`."
    }
  }
}
