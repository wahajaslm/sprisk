{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Shared definitions. Referenced as #/$defs/<Name> from any schema file.",
  "$defs": {
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SchemaId": {
      "type": "string",
      "pattern": "^sch_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:[0-5][0-9]Z$",
      "description": "UTC, whole seconds, Z suffix. One canonical form so every language round-trips it unchanged. Pattern only: typify ignores pattern when format is set."
    },
    "InvestigationId": {
      "type": "string",
      "pattern": "^inv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "QuestionVersionId": {
      "type": "string",
      "pattern": "^qv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MethodologyProposalId": {
      "type": "string",
      "pattern": "^mpr_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "MethodologyDecisionId": {
      "type": "string",
      "pattern": "^mdc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "PipelineVersionId": {
      "type": "string",
      "pattern": "^plv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "NotebookId": {
      "type": "string",
      "pattern": "^nb_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "NotebookVersionId": {
      "type": "string",
      "pattern": "^nbv_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "RunId": {
      "type": "string",
      "pattern": "^run_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "WorkerId": {
      "type": "string",
      "pattern": "^wrk_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "NodeId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$",
      "description": "Node name, unique within a pipeline version."
    },
    "PortName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,62}$"
    },
    "OperatorRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$",
      "description": "Pinned operator: dotted name @ semver, e.g. sprisk.eval.binary_classification@1.0.0."
    },
    "Params": {
      "type": "object",
      "description": "Operator parameters. Validated against the operator's params_schema by the compiler, not here.",
      "additionalProperties": true
    },
    "Error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
