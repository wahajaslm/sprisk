{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RuleObservation": {
      "title": "RuleObservation",
      "description": "What a rule's decide() reads (ADR-0042): confirmed question facts and measured profile values, never raw rows, plus its settings. Sent by Rust to the Python rule runner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rule",
        "facts",
        "profile",
        "settings"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.rule_observation/v1"
        },
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "facts": {
          "type": "object",
          "description": "Facts by name: question facts, e.g. question.time_column, and facts read from the flow, e.g. flow.model_family.",
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          }
        },
        "profile": {
          "type": "object",
          "description": "Measured profile values by name.",
          "additionalProperties": { "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }] }
        },
        "settings": {
          "type": "object",
          "description": "The rule's settings: policy thresholds with any overrides.",
          "additionalProperties": true
        }
      }
    },
    "RuleDecision": {
      "title": "RuleDecision",
      "description": "What a rule's decide() returns (ADR-0042). Rust builds graph effects from it with the manifest's actions; it never runs as code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rule",
        "recommended_alternative_id",
        "alternatives",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.rule_decision/v1"
        },
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "recommended_alternative_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "applicability",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              },
              "applicability": {
                "type": "string",
                "enum": [
                  "applicable",
                  "needs_fact",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "$ref": "#/$defs/Params",
                "description": "Concrete params for the manifest action's operator; present when applicable."
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodologyEvidence"
          }
        }
      }
    },
    "MethodologyRuleRef": {
      "type": "string",
      "description": "methodology.<pack>.<rule>@<semver>",
      "pattern": "^methodology\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*@\\d+\\.\\d+\\.\\d+$"
    },
    "MethodologyStage": {
      "type": "string",
      "description": "ADR-0042 stages, run in this order.",
      "enum": [
        "question",
        "data",
        "cleaning",
        "split",
        "features",
        "models",
        "evaluation",
        "reporting"
      ]
    },
    "MethodologyRule": {
      "title": "MethodologyRule",
      "description": "The declarative manifest of one methodology rule package (ADR-0042), loaded from methodology/<pack>/rules/<rule>/rule.yaml. Served read-only by GET /methodology_rules.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "name",
        "stage",
        "decides",
        "provenance",
        "observes",
        "policy_thresholds",
        "alternatives",
        "verification"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.methodology_rule/v1"
        },
        "id": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/MethodologyStage"
        },
        "needs": {
          "type": "array",
          "description": "Facts and earlier decisions this rule reads, e.g. question.time_column; they order rules inside a stage (ADR-0042).",
          "items": { "type": "string", "minLength": 1 }
        },
        "decides": {
          "type": "string",
          "description": "The one decision this rule owns; unique across loaded packs.",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard",
            "citation",
            "pitfall",
            "corner_cases"
          ],
          "properties": {
            "standard": {
              "type": "string",
              "minLength": 1
            },
            "citation": {
              "type": "string",
              "minLength": 1
            },
            "pitfall": {
              "type": "string",
              "minLength": 1
            },
            "corner_cases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "observes": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "description",
                  "required"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "description",
                  "required"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "policy_thresholds": {
          "type": "object",
          "description": "Default thresholds the rule decides with.",
          "additionalProperties": true
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "condition",
              "rationale",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "description": "Human-readable summary of when this applies. Documentation only: the rule's Python decide() is the logic (ADR-0042)."
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "settings_schema": {
                "type": "object",
                "description": "JSON Schema for this alternative's settings."
              },
              "action": {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": { "type": "string", "minLength": 1 },
                  "operator": { "type": "string", "minLength": 1, "description": "Operator the action builds; may name one not yet registered." },
                  "placement": { "type": "string", "minLength": 1 },
                  "fit_on": { "type": "string", "minLength": 1 },
                  "apply_to": { "type": "string", "minLength": 1 },
                  "params": { "type": "object", "description": "Operator params; '{settings.x}' strings are filled from the alternative's settings." }
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "invariant"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "invariant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "MethodologyRuleSource": {
      "title": "MethodologyRuleSource",
      "description": "Read-only files of one rule package: its manifest and, when present, its Python decide() module. Served by GET /methodology_rules/{id}/source; the API reads only files inside the rule's folder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "files"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "language",
              "text"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative to the rule folder, e.g. rule.yaml. Never an absolute path.",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
              },
              "language": {
                "type": "string",
                "enum": [
                  "yaml",
                  "python"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "MethodologyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "value", "origin"],
      "properties": {
        "kind": { "type": "string", "enum": ["question_fact", "profile_fact", "flow_fact", "policy", "user_reason"] },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/Origin" },
        "artifact_id": { "$ref": "#/$defs/ArtifactId" }
      }
    },
    "GraphEffect": {
      "description": "Typed mutation previewed and compiled before it can create a pipeline version.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node_id", "operator", "params"],
          "properties": {
            "kind": { "const": "replace_node" },
            "node_id": { "$ref": "#/$defs/NodeId" },
            "operator": { "$ref": "#/$defs/OperatorRef" },
            "params": { "$ref": "#/$defs/Params" }
          }
        }
      ]
    },
    "MethodologyAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "applicability", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "enum": ["applicable", "needs_fact", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "effect": { "$ref": "#/$defs/GraphEffect" }
      }
    },
    "DecisionProposal": {
      "title": "DecisionProposal",
      "description": "Immutable resolver output. It explains alternatives and previews typed effects; it does not mutate a graph.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "rule", "question_version_id", "pipeline_version_id", "subject_node_id", "evidence", "alternatives", "fingerprint", "created_at"],
      "properties": {
        "schema_version": { "const": "sprisk.decision_proposal/v1" },
        "id": { "$ref": "#/$defs/MethodologyProposalId" },
        "rule": { "$ref": "#/$defs/CheckRef" },
        "question_version_id": { "$ref": "#/$defs/QuestionVersionId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "subject_node_id": { "$ref": "#/$defs/NodeId" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/MethodologyEvidence" } },
        "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MethodologyAlternative" } },
        "recommended_alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "fingerprint": { "$ref": "#/$defs/ContentHash" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "ApplyMethodologyDecision": {
      "title": "ApplyMethodologyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative_id", "idempotency_key"],
      "properties": {
        "alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "reason": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "MethodologyDecision": {
      "title": "MethodologyDecision",
      "description": "Immutable record of an alternative atomically applied to a new pipeline version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "proposal_id", "rule", "question_version_id", "base_pipeline_version_id", "pipeline_version_id", "subject_node_id", "alternative_id", "created_at"],
      "properties": {
        "schema_version": { "const": "sprisk.methodology_decision/v1" },
        "id": { "$ref": "#/$defs/MethodologyDecisionId" },
        "proposal_id": { "$ref": "#/$defs/MethodologyProposalId" },
        "rule": { "$ref": "#/$defs/CheckRef" },
        "question_version_id": { "$ref": "#/$defs/QuestionVersionId" },
        "base_pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "subject_node_id": { "$ref": "#/$defs/NodeId" },
        "alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "reason": { "type": "string", "minLength": 1 },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AppliedMethodologyDecision": {
      "title": "AppliedMethodologyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "pipeline"],
      "properties": {
        "decision": { "$ref": "#/$defs/MethodologyDecision" },
        "pipeline": { "$ref": "#/$defs/PipelineVersion" }
      }
    }
  }
}
