{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "RuleObservation": {
      "title": "RuleObservation",
      "description": "What a rule's decide() reads (ADR-0042): confirmed question facts and measured profile values, never raw rows, plus its settings. Sent by Rust to the Python rule runner.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rule",
        "facts",
        "profile",
        "settings"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.rule_observation/v1"
        },
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "facts": {
          "type": "object",
          "description": "Facts by name: question facts (question.time_column), facts read from the flow (flow.model_families), and the step's own text settings (step.method). A fact that lists several values joins them, sorted, with ', '.",
          "additionalProperties": {
            "$ref": "#/$defs/Fact"
          }
        },
        "profile": {
          "type": "object",
          "description": "Measured profile values by name. A list holds dataset text, such as the values of a column that do not read as numbers.",
          "additionalProperties": { "oneOf": [{ "type": "number" }, { "type": "string" }, { "type": "boolean" }, { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } }] }
        },
        "settings": {
          "type": "object",
          "description": "The rule's settings: policy thresholds with any overrides.",
          "additionalProperties": true
        }
      }
    },
    "RuleDecision": {
      "title": "RuleDecision",
      "description": "What a rule's decide() returns (ADR-0042). Rust builds graph effects from it with the manifest's actions; it never runs as code.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "rule",
        "alternatives",
        "evidence"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.rule_decision/v1"
        },
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "recommended_alternative_id": {
          "type": "string",
          "description": "The one alternative a recommend rule picks; absent for a shortlist rule.",
          "pattern": "^[a-z][a-z0-9_]{0,62}$"
        },
        "shortlist": {
          "type": "array",
          "description": "The alternatives a shortlist rule puts forward to compare; absent for a recommend rule (ADR-0044).",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        },
        "alternatives": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "applicability",
              "reason"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              },
              "applicability": {
                "type": "string",
                "enum": [
                  "applicable",
                  "needs_fact",
                  "not_applicable"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "params": {
                "$ref": "#/$defs/Params",
                "description": "Concrete params for the manifest action's operator; present when applicable."
              }
            }
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MethodologyEvidence"
          }
        }
      }
    },
    "RuleRequest": {
      "title": "RuleRequest",
      "description": "Rust to the rule session (`python -m sprisk_workers.rule`), one JSON line per decision (ADR-0059): the rule module Rust picked from the loaded catalog, and its observation. One session serves a whole review.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "module", "observation"],
      "properties": {
        "schema_version": { "const": "sprisk.rule_request/v1" },
        "module": { "type": "string", "minLength": 1, "description": "Path of the rule's rule.py, from the catalog Rust loaded; never from a client. A local path, so this message is only for the rule process on the same machine, never stored." },
        "observation": { "$ref": "#/$defs/RuleObservation" }
      }
    },
    "RuleAnswer": {
      "title": "RuleAnswer",
      "description": "The rule session's one JSON line per RuleRequest, tagged by `answer`: the rule's decision, or why the rule refused its observation. Any other failure ends the session.",
      "oneOf": [{ "$ref": "#/$defs/RuleDecided" }, { "$ref": "#/$defs/RuleRefused" }]
    },
    "RuleDecided": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "decision"],
      "properties": {
        "answer": { "type": "string", "enum": ["decided"] },
        "decision": { "$ref": "#/$defs/RuleDecision" }
      }
    },
    "RuleRefused": {
      "type": "object",
      "additionalProperties": false,
      "required": ["answer", "error"],
      "properties": {
        "answer": { "type": "string", "enum": ["refused"] },
        "error": { "type": "string", "minLength": 1, "description": "The rule's own error (a broken observation, a module with no decide). It may name local paths, so it goes to the log, not to a client." }
      }
    },
    "MethodologyRuleRef": {
      "type": "string",
      "description": "methodology.<pack>.<rule>@<semver>",
      "pattern": "^methodology\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*@\\d+\\.\\d+\\.\\d+$"
    },
    "MethodologyStage": {
      "type": "string",
      "description": "Stages in decision order (ADR-0059): the split comes before cleaning, since cleaning rules measure train rows.",
      "enum": [
        "question",
        "data",
        "split",
        "cleaning",
        "features",
        "models",
        "evaluation",
        "reporting"
      ]
    },
    "MethodologyRule": {
      "title": "MethodologyRule",
      "description": "The declarative manifest of one methodology rule package (ADR-0042), loaded from methodology/<pack>/rules/<rule>/rule.yaml. Served read-only by GET /methodology_rules.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "name",
        "stage",
        "decides",
        "status",
        "provenance",
        "policy_thresholds",
        "alternatives",
        "verification"
      ],
      "properties": {
        "schema_version": {
          "const": "sprisk.methodology_rule/v1"
        },
        "id": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "stage": {
          "$ref": "#/$defs/MethodologyStage"
        },
        "selection": {
          "type": "string",
          "enum": ["recommend", "shortlist"],
          "description": "recommend (the default): decide() picks one alternative. shortlist: it puts forward the registry's models worth comparing (ADR-0044)."
        },
        "status": {
          "type": "string",
          "enum": ["draft", "active"],
          "description": "draft: a design with no rule.py, never run; its condition and observes are notes. active: has rule.py, applies_to, reads and examples, and no notes (ADR-0045)."
        },
        "applies_to": {
          "type": "array",
          "description": "Operators, without version, whose steps this active rule decides. Rust routes from it (ADR-0045).",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$" }
        },
        "reads": {
          "type": "array",
          "description": "Facts this active rule may read, by name from the fact catalog, e.g. question.target or column.*.kurtosis; * stands for a column or setting name. Rust sends only these (ADR-0045).",
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "description": "Inputs and the alternative decide() picks for them. Run as tests and shown in place of conditions (ADR-0045).",
          "items": { "$ref": "#/$defs/RuleExample" }
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "description": "The decision as a person asks it, e.g. How should missing values be filled? Shown on the Methodology page; nothing that decides reads it. Required on an active rule (ADR-0045 amendment)."
        },
        "decides": {
          "type": "string",
          "description": "The one decision this rule owns; unique across loaded packs.",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "standard",
            "citation",
            "pitfall",
            "corner_cases"
          ],
          "properties": {
            "standard": {
              "type": "string",
              "minLength": 1
            },
            "citation": {
              "type": "string",
              "minLength": 1
            },
            "pitfall": {
              "type": "string",
              "minLength": 1
            },
            "corner_cases": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "observes": {
          "type": "array",
          "description": "Design notes on a draft rule's inputs; an active rule declares reads instead.",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "profile",
                  "description",
                  "required"
                ],
                "properties": {
                  "profile": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "fact",
                  "description",
                  "required"
                ],
                "properties": {
                  "fact": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string"
                  },
                  "required": {
                    "type": "boolean"
                  }
                }
              }
            ]
          }
        },
        "policy_thresholds": {
          "type": "object",
          "description": "Default thresholds the rule decides with.",
          "additionalProperties": true
        },
        "alternatives": {
          "type": "array",
          "description": "A recommend rule's menu. A shortlist rule has none: its candidates come from the registry (ADR-0044).",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "label",
              "description",
              "rationale",
              "action"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,62}$"
              },
              "label": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "condition": {
                "type": "string",
                "description": "A draft rule's design note on when this applies. An active rule has none: its decide() is the logic, shown by its examples (ADR-0045)."
              },
              "when": {
                "type": "string",
                "minLength": 1,
                "description": "In a few words, when the rule takes this route, e.g. the column is skewed. Shown beside the example that picks it; nothing that decides reads it. Required on an active rule's alternatives (ADR-0045 amendment)."
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              },
              "settings_schema": {
                "type": "object",
                "description": "JSON Schema for this alternative's settings."
              },
              "action": {
                "type": "object",
                "required": [
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "type": { "$ref": "#/$defs/RuleActionType" },
                  "operator": { "type": "string", "minLength": 1, "description": "Operator the action builds; may name one not yet registered." },
                  "placement": { "type": "string", "minLength": 1 },
                  "node_id": { "$ref": "#/$defs/NodeId", "description": "insert_step: the id of the step it adds, saying what the step is about (ADR-0057)." },
                  "fit_on": { "type": "string", "minLength": 1 },
                  "apply_to": { "type": "string", "minLength": 1 },
                  "params": { "type": "object", "description": "Operator params; '{settings.x}' strings are filled from the alternative's settings." }
                }
              }
            }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "check_id",
            "invariant"
          ],
          "properties": {
            "check_id": {
              "type": "string",
              "minLength": 1
            },
            "invariant": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "MethodologyRuleSource": {
      "title": "MethodologyRuleSource",
      "description": "Read-only files of one rule package: its manifest and, when present, its Python decide() module. Served by GET /methodology_rules/{id}/source; the API reads only files inside the rule's folder.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "files"
      ],
      "properties": {
        "rule": {
          "$ref": "#/$defs/MethodologyRuleRef"
        },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "language",
              "text"
            ],
            "properties": {
              "path": {
                "type": "string",
                "description": "Relative to the rule folder, e.g. rule.yaml. Never an absolute path.",
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_./-]*$"
              },
              "language": {
                "type": "string",
                "enum": [
                  "yaml",
                  "python"
                ]
              },
              "text": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "MethodologyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "label", "value", "origin"],
      "properties": {
        "kind": { "type": "string", "enum": ["question_fact", "profile_fact", "flow_fact", "policy", "user_reason"] },
        "label": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "origin": { "$ref": "#/$defs/Origin" },
        "artifact_id": { "$ref": "#/$defs/ArtifactId" }
      }
    },
    "RuleExample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["given"],
      "properties": {
        "given": {
          "type": "object",
          "description": "Facts by name. A question fact is confirmed and a flow fact measured unless given as { value, origin }. A measured fact may also be a list of dataset text.",
          "additionalProperties": {
            "oneOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "origin"],
                "properties": {
                  "value": { "type": "string", "minLength": 1 },
                  "origin": { "$ref": "#/$defs/Origin" }
                }
              }
            ]
          }
        },
        "picks": { "type": "string", "description": "What a recommend rule picks.", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "shortlist": {
          "type": "array",
          "description": "What a shortlist rule puts forward.",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        }
      }
    },
    "RuleActionType": {
      "type": "string",
      "description": "What choosing an alternative does to the flow. Rust builds graph effects for replace_node, remove_node (ADR-0043) and insert_step before the rule's step (ADR-0057); reopen changes nothing in the flow: recommended, it makes the review item `reopen` for the stage its params name (ADR-0059). The others describe actions not wired yet. A new type is a contract change, so a typo cannot pass as a silent no-op.",
      "enum": [
        "replace_node",
        "remove_node",
        "insert_step",
        "pass_through",
        "update_estimator_params",
        "configure_clustering_cardinality",
        "configure_clustering_distance",
        "configure_dbscan_params",
        "configure_evaluation_params",
        "emit_methodology_limitation",
        "enforce_compiler_invariant",
        "reopen"
      ]
    },
    "GraphEffect": {
      "description": "Typed mutation previewed and compiled before it can create a pipeline version.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "node_id", "operator", "params"],
          "properties": {
            "kind": { "const": "replace_node" },
            "node_id": { "$ref": "#/$defs/NodeId" },
            "operator": { "$ref": "#/$defs/OperatorRef" },
            "params": { "$ref": "#/$defs/Params" }
          }
        },
        {
          "type": "object",
          "description": "Removes the step and feeds each of its outputs from its input of the same name (ADR-0043).",
          "additionalProperties": false,
          "required": ["kind", "node_id"],
          "properties": {
            "kind": { "const": "remove_node" },
            "node_id": { "$ref": "#/$defs/NodeId" }
          }
        },
        {
          "type": "object",
          "description": "Adds step node_id before step `before`, on the train and test rows `before` learns from (ADR-0057).",
          "additionalProperties": false,
          "required": ["kind", "node_id", "operator", "params", "before"],
          "properties": {
            "kind": { "const": "insert_node" },
            "node_id": { "$ref": "#/$defs/NodeId" },
            "operator": { "$ref": "#/$defs/OperatorRef" },
            "params": { "$ref": "#/$defs/Params" },
            "before": { "$ref": "#/$defs/NodeId" },
            "other": { "$ref": "#/$defs/PortRef", "description": "A step that joins: the output feeding its `other` input, a source table no step read before (ADR-0059). Absent for a step with one input." }
          }
        },
        {
          "type": "object",
          "description": "Adds step node_id beside the flow: each of its inputs reads the output named in inputs, and no step reads it yet, such as an evidence producer (ADR-0063).",
          "additionalProperties": false,
          "required": ["kind", "node_id", "operator", "params", "inputs"],
          "properties": {
            "kind": { "const": "add_node" },
            "node_id": { "$ref": "#/$defs/NodeId" },
            "operator": { "$ref": "#/$defs/OperatorRef" },
            "params": { "$ref": "#/$defs/Params" },
            "inputs": {
              "type": "object",
              "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,62}$" },
              "additionalProperties": { "$ref": "#/$defs/PortRef" }
            }
          }
        },
        {
          "type": "object",
          "description": "Feeds input port of step node_id from output from instead of what fed it (ADR-0063).",
          "additionalProperties": false,
          "required": ["kind", "node_id", "port", "from"],
          "properties": {
            "kind": { "const": "set_input" },
            "node_id": { "$ref": "#/$defs/NodeId" },
            "port": { "$ref": "#/$defs/PortName" },
            "from": { "$ref": "#/$defs/PortRef" }
          }
        }
      ]
    },
    "MethodologyAlternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "description", "applicability", "reason"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "applicability": { "type": "string", "enum": ["applicable", "needs_fact", "not_applicable"] },
        "reason": { "type": "string", "minLength": 1 },
        "effect": { "$ref": "#/$defs/GraphEffect" }
      }
    },
    "DecisionProposal": {
      "title": "DecisionProposal",
      "description": "Immutable resolver output. It explains alternatives and previews typed effects; it does not mutate a graph.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "rule", "question_version_id", "pipeline_version_id", "subject_node_id", "evidence", "alternatives", "fingerprint", "created_at"],
      "properties": {
        "schema_version": { "const": "sprisk.decision_proposal/v1" },
        "id": { "$ref": "#/$defs/MethodologyProposalId" },
        "rule": { "$ref": "#/$defs/CheckRef", "description": "The rule whose decide() made it, or the compared method whose options it offers a person (ADR-0063 D3)." },
        "question_version_id": { "$ref": "#/$defs/QuestionVersionId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "subject_node_id": { "$ref": "#/$defs/NodeId" },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/MethodologyEvidence" } },
        "alternatives": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/MethodologyAlternative" } },
        "recommended_alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "shortlist": {
          "type": "array",
          "description": "The alternatives a shortlist rule puts forward to compare (ADR-0044).",
          "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" }
        },
        "fingerprint": { "$ref": "#/$defs/ContentHash" },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MethodologyReview": {
      "title": "MethodologyReview",
      "description": "Every applicable rule's status on one pipeline version, in decision order (ADR-0059). Read-only: it stores nothing.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "pipeline_version_id", "items", "next"],
      "properties": {
        "schema_version": { "const": "sprisk.methodology_review/v1" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/MethodologyReviewItem" } },
        "next": {
          "type": "array",
          "description": "Indexes into items of the open items with nothing open before them.",
          "items": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "MethodologyReviewItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "decides", "stage", "status", "reason"],
      "properties": {
        "rule": { "$ref": "#/$defs/CheckRef" },
        "decides": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "stage": { "$ref": "#/$defs/MethodologyStage" },
        "subject_node_id": { "$ref": "#/$defs/NodeId" },
        "status": { "$ref": "#/$defs/MethodologyReviewStatus" },
        "reason": { "type": "string", "minLength": 1 },
        "recommended_alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "reopens": { "$ref": "#/$defs/MethodologyStage", "description": "With status reopen: the stage the results send the flow back to. Absent otherwise." }
      }
    },
    "MethodologyReviewStatus": {
      "type": "string",
      "description": "settled: the flow matches the rule's decision. proposal: the rule wants a change. needs_fact: a person must state a fact. needs_run: it measures train rows the flow has not produced. waiting: an earlier open item changes what it reads. no_subject: no step for it to decide yet. not_applicable: the rule does not apply to this step. reopen: cross-validation results say the stage in `reopens` must change; it stays open until the flow does (ADR-0059).",
      "enum": ["settled", "proposal", "needs_fact", "needs_run", "waiting", "no_subject", "not_applicable", "reopen"]
    },
    "ApplyMethodologyDecision": {
      "title": "ApplyMethodologyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative_id", "idempotency_key"],
      "properties": {
        "alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "reason": { "type": "string", "minLength": 1 },
        "idempotency_key": { "type": "string", "minLength": 8, "maxLength": 128 }
      }
    },
    "MethodologyDecision": {
      "title": "MethodologyDecision",
      "description": "Immutable record of one decision made through Apply: a rule's alternative, or a method's option (ADR-0064).",
      "oneOf": [{ "$ref": "#/$defs/MethodologyDecisionByRule" }, { "$ref": "#/$defs/MethodologyDecisionByMethod" }]
    },
    "MethodologyDecisionByRule": {
      "title": "MethodologyDecisionByRule",
      "description": "A rule's alternative atomically applied to a new pipeline version.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "proposal_id", "rule", "question_version_id", "base_pipeline_version_id", "pipeline_version_id", "subject_node_id", "alternative_id", "created_at"],
      "properties": {
        "schema_version": { "const": "sprisk.methodology_decision/v1" },
        "id": { "$ref": "#/$defs/MethodologyDecisionId" },
        "proposal_id": { "$ref": "#/$defs/MethodologyProposalId" },
        "rule": { "$ref": "#/$defs/CheckRef" },
        "question_version_id": { "$ref": "#/$defs/QuestionVersionId" },
        "base_pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "subject_node_id": { "$ref": "#/$defs/NodeId" },
        "alternative_id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
        "reason": { "type": "string", "minLength": 1 },
        "selection_id": {
          "$ref": "#/$defs/ArtifactId",
          "description": "The SelectionDecision this choice followed or overrode (ADR-0050). Absent when no comparison had decided."
        },
        "missed_guardrails": {
          "type": "array",
          "items": { "$ref": "#/$defs/GuardrailResult" },
          "description": "The guardrails the chosen alternative failed in the SelectionDecision this choice overrode, with its values (ADR-0052). Absent when it failed none."
        },
        "test_rows_seen_by": {
          "type": "array",
          "items": { "$ref": "#/$defs/PipelineVersionId" },
          "description": "Earlier versions applied from the same proposal whose runs had already scored the test rows (arch doc §11). Absent when none had."
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MethodologyDecisionByMethod": {
      "title": "MethodologyDecisionByMethod",
      "description": "A method's option taken through the same Apply as a rule's (ADR-0064): keyed per walk round, refused on a changed base, and cited by every step it changed.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "method", "decides", "option", "assurance", "reason", "question_version_id", "base_pipeline_version_id", "created_at"],
      "properties": {
        "schema_version": { "enum": ["sprisk.methodology_decision/v1"] },
        "id": { "$ref": "#/$defs/MethodologyDecisionId" },
        "method": { "$ref": "#/$defs/MethodRef" },
        "decides": { "type": "string", "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$" },
        "option": { "$ref": "#/$defs/MethodOptionId" },
        "assurance": { "$ref": "#/$defs/MethodAssurance" },
        "reason": { "type": "string", "minLength": 1 },
        "question_version_id": { "$ref": "#/$defs/QuestionVersionId" },
        "base_pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId", "description": "The version the option made. Absent when it changed no step." },
        "effects": { "type": "array", "items": { "$ref": "#/$defs/GraphEffect" }, "description": "The patch the option applied, in order. Absent: it changed no step." },
        "selection_id": { "$ref": "#/$defs/ArtifactId", "description": "The SelectionDecision a compared method's option won by (ADR-0063 D3, ADR-0050). Absent for any other method." },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/Binding" }, "description": "The bindings the option made. Absent: none." },
        "promises": { "type": "array", "items": { "$ref": "#/$defs/VerificationName" }, "description": "The verifications the option promises, by name. Absent: none." },
        "evidence": { "type": "array", "items": { "$ref": "#/$defs/UsedEvidence" }, "description": "What the method read, whether it chose or a person answered. Absent: it read none." },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "AppliedMethodologyDecision": {
      "title": "AppliedMethodologyDecision",
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "pipeline"],
      "properties": {
        "decision": { "$ref": "#/$defs/MethodologyDecision" },
        "pipeline": { "$ref": "#/$defs/PipelineVersion" }
      }
    },
    "ModelSelection": {
      "title": "ModelSelection",
      "description": "How Sprisk is choosing one step of a flow's model pipeline (ADR-0050): a model step's shortlist proposal, or a preparation step's proposal; the version that cross-validates it; and that version's latest run. Its select step's output is the SelectionDecision.",
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal", "comparison", "run"],
      "properties": {
        "proposal": { "$ref": "#/$defs/DecisionProposal" },
        "comparison": { "$ref": "#/$defs/PipelineVersion" },
        "run": { "$ref": "#/$defs/Run" }
      }
    }
  }
}
