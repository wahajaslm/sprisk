{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sprisk.dev/schemas/artifact.schema.json",
  "title": "Artifact",
  "description": "Immutable, content-addressed output of a step attempt (arch doc \u00a74, \u00a710).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "project_id",
    "producer_attempt_id",
    "content_hash",
    "media_type",
    "size_bytes",
    "uri",
    "created_at"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "sprisk.artifact/v1"
      ]
    },
    "id": {
      "$ref": "#/$defs/ArtifactId"
    },
    "project_id": {
      "$ref": "#/$defs/ProjectId"
    },
    "producer_attempt_id": {
      "$ref": "#/$defs/AttemptId"
    },
    "content_hash": {
      "$ref": "#/$defs/ContentHash"
    },
    "media_type": {
      "type": "string",
      "pattern": "^[a-z]+/[a-z0-9.+-]+$",
      "description": "IANA media type of the stored bytes."
    },
    "schema_ref": {
      "$ref": "#/$defs/SchemaId",
      "description": "Declared data schema. Absent for artifacts without a tabular schema, such as model bundles."
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "uri": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9+.-]*://.+$",
      "description": "Storage location. Opaque to domain logic; resolved by the artifact store."
    },
    "created_at": {
      "$ref": "#/$defs/Timestamp"
    }
  },
  "$defs": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^art_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ProjectId": {
      "type": "string",
      "pattern": "^prj_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "AttemptId": {
      "type": "string",
      "pattern": "^att_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "SchemaId": {
      "type": "string",
      "pattern": "^sch_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "ContentHash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Timestamp": {
      "type": "string",
      "pattern": "^\\d{4}-(0[1-9]|1[0-2])-(0[1-9]|[12]\\d|3[01])T([01]\\d|2[0-3]):[0-5]\\d:[0-5]\\dZ$",
      "description": "UTC, whole seconds, Z suffix. One canonical form so every language round-trips it unchanged. Pattern only: typify ignores pattern when format is set."
    }
  }
}
