{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MethodologyCheck": {
      "title": "MethodologyCheck",
      "description": "Result of one Gate B methodology rule on one pipeline version (arch doc §4, §8). Immutable; re-checking creates a new record.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "id", "pipeline_version_id", "check", "verdict", "rationale", "cited_nodes", "created_at"],
      "properties": {
        "schema_version": { "type": "string", "enum": ["sprisk.methodology_check/v1"] },
        "id": { "$ref": "#/$defs/MethodologyCheckId" },
        "pipeline_version_id": { "$ref": "#/$defs/PipelineVersionId" },
        "check": { "$ref": "#/$defs/CheckRef" },
        "verdict": { "$ref": "#/$defs/Verdict" },
        "rationale": { "type": "string", "minLength": 1 },
        "cited_nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/NodeId" },
          "description": "Nodes the verdict is about. Empty when the rule found nothing to inspect."
        },
        "limitations": {
          "type": "string",
          "minLength": 1,
          "description": "What the rule could not assess. Omitted when there is nothing to say."
        },
        "created_at": { "$ref": "#/$defs/Timestamp" }
      }
    },
    "MethodologyCheckId": {
      "type": "string",
      "pattern": "^mck_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "CheckRef": {
      "type": "string",
      "description": "Pinned rule: <pack>.<rule>@<semver>.",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+@(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "Verdict": {
      "type": "string",
      "enum": ["pass", "fail", "warning", "not_assessed"]
    }
  }
}
