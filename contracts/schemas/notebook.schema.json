{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "Session notebooks (ADR-0036): the saved document and the kernel's wire messages.",
  "$defs": {
    "NotebookVersion": {
      "title": "NotebookVersion",
      "description": "One saved state of a notebook (ADR-0036): its ordered code and Markdown cells. Immutable; each save is a new version. Outputs are not saved: they belong to the session.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "id",
        "notebook_id",
        "project_id",
        "title",
        "cells",
        "created_at"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "enum": [
            "sprisk.notebook_version/v1"
          ]
        },
        "id": {
          "$ref": "#/$defs/NotebookVersionId"
        },
        "notebook_id": {
          "$ref": "#/$defs/NotebookId"
        },
        "project_id": {
          "$ref": "#/$defs/ProjectId"
        },
        "parent_id": {
          "$ref": "#/$defs/NotebookVersionId",
          "description": "Version this one was saved over. Absent for a notebook's first version."
        },
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId",
          "description": "The flow version this notebook was made in or last synced into (ADR-0037). The notebook belongs to that flow and its later versions. Absent: not in a flow yet."
        },
        "title": {
          "type": "string",
          "maxLength": 200
        },
        "cells": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotebookCell"
          }
        },
        "created_at": {
          "$ref": "#/$defs/Timestamp"
        }
      }
    },
    "NotebookCell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "source"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/NotebookCellId"
        },
        "kind": {
          "type": "string",
          "enum": [
            "code",
            "markdown"
          ]
        },
        "source": {
          "type": "string",
          "maxLength": 100000
        }
      }
    },
    "NotebookCellId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,64}$",
      "description": "Stable within a notebook across versions, as in Jupyter's nbformat 4.5."
    },
    "NotebookExecute": {
      "title": "NotebookExecute",
      "description": "Run one cell's code in the notebook's session kernel (ADR-0036). Body of POST /notebooks/{id}/execute.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell_id",
        "code"
      ],
      "properties": {
        "cell_id": {
          "$ref": "#/$defs/NotebookCellId"
        },
        "code": {
          "type": "string",
          "maxLength": 100000
        }
      }
    },
    "NotebookExecution": {
      "title": "NotebookExecution",
      "description": "What one cell did in the session kernel: its execution count, what it printed and showed (capped, as a code step's display), and its error. Scratch, not provenance (ADR-0036).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "outputs"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "ok",
            "error",
            "interrupted",
            "timed_out"
          ]
        },
        "execution_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The kernel's count for this execution. Absent when the cell never got one (timed out before it started)."
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisplayItem"
          }
        },
        "error": {
          "$ref": "#/$defs/NotebookError",
          "description": "Present when status is error or interrupted."
        },
        "kernel_restarted": {
          "type": "boolean",
          "description": "Present and true when the kernel restarted before or during this cell (memory cap, crash, stuck interrupt): every variable is gone. Absent otherwise."
        }
      }
    },
    "NotebookExecutionEvent": {
      "title": "NotebookExecutionEvent",
      "description": "One line of a cell's execution as it happens (ADR-0041), from the session host to Rust and, when asked with Accept: application/x-ndjson, from POST /notebooks/{id}/execute to the browser. Tagged by `kind`: `running` lines carry every output so far; the last line is `done`, or `failed` when the kernel stopped answering after the stream began (earlier failures are an HTTP error).",
      "oneOf": [
        {
          "$ref": "#/$defs/ExecutionRunning"
        },
        {
          "$ref": "#/$defs/ExecutionDone"
        },
        {
          "$ref": "#/$defs/ExecutionFailed"
        }
      ]
    },
    "ExecutionRunning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "outputs"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "running"
          ]
        },
        "execution_count": {
          "type": "integer",
          "minimum": 0,
          "description": "The kernel's count for this execution, once it has one."
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisplayItem"
          },
          "description": "Every output so far, not only the new ones, capped as in the result."
        }
      }
    },
    "ExecutionDone": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "execution"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "done"
          ]
        },
        "execution": {
          "$ref": "#/$defs/NotebookExecution"
        }
      }
    },
    "ExecutionFailed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "problem"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "failed"
          ]
        },
        "problem": {
          "$ref": "#/$defs/Problem"
        }
      }
    },
    "NotebookError": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message",
        "traceback"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "traceback": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plain text lines, colour codes removed."
        }
      }
    },
    "NotebookVariables": {
      "title": "NotebookVariables",
      "description": "Which names the session kernel holds and whether each is a table, so Create node can refuse an output that cannot cross a boundary (ADR-0036).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "variables"
      ],
      "properties": {
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotebookVariable"
          }
        }
      }
    },
    "NotebookVariable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "defined",
        "table"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/PortName"
        },
        "defined": {
          "type": "boolean"
        },
        "type": {
          "type": "string",
          "description": "Module and class, e.g. pandas.DataFrame. Absent when not defined."
        },
        "table": {
          "type": "boolean",
          "description": "A pandas or polars DataFrame: the one kind of value that crosses a node boundary today."
        }
      }
    },
    "NotebookKernelRequest": {
      "title": "NotebookKernelRequest",
      "description": "Rust to the session host, one JSON line each (ADR-0036). Tagged by `op`. The host answers execute with NotebookExecutionEvent lines ending in `done` (ADR-0041) and variables with NotebookVariables; interrupt and shutdown get no answer.",
      "oneOf": [
        {
          "$ref": "#/$defs/KernelExecute"
        },
        {
          "$ref": "#/$defs/KernelInterrupt"
        },
        {
          "$ref": "#/$defs/KernelVariables"
        },
        {
          "$ref": "#/$defs/KernelShutdown"
        }
      ]
    },
    "KernelExecute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "code"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "execute"
          ]
        },
        "code": {
          "type": "string",
          "maxLength": 100000
        }
      }
    },
    "KernelInterrupt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "interrupt"
          ]
        }
      }
    },
    "KernelVariables": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "names"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "variables"
          ]
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PortName"
          }
        }
      }
    },
    "KernelShutdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op"
      ],
      "properties": {
        "op": {
          "type": "string",
          "enum": [
            "shutdown"
          ]
        }
      }
    }
  }
}
