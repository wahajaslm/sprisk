{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CreateRun": {
      "title": "CreateRun",
      "description": "Request body for POST /runs: run a pipeline version that already passed Gate A.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version_id"
      ],
      "properties": {
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId"
        }
      }
    },
    "AttemptOutput": {
      "title": "AttemptOutput",
      "description": "One committed output of an attempt: the port that produced it and the artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "artifact"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/PortName"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      }
    },
    "Problem": {
      "title": "Problem",
      "description": "Error response body. Lists every problem found, not only the first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Error"
          }
        }
      }
    },
    "TablePage": {
      "title": "TablePage",
      "description": "One page of rows from a tabular artifact, for display (GET /artifacts/{id}/rows). Cells are display text, cut to a bounded length; a missing cell is listed by column index and its text is empty. Wide tables return only their first columns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "total_rows",
        "total_columns",
        "columns",
        "rows"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the first row in this page."
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total_columns": {
          "type": "integer",
          "minimum": 0,
          "description": "Columns in the table; more than `columns` holds when the table is too wide to page whole."
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableRow"
          }
        }
      }
    },
    "TableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "type": "string",
          "description": "Arrow data type name, for display only."
        }
      }
    },
    "TableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "missing"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Indexes of columns whose value is missing in this row."
        }
      }
    }
  }
}
