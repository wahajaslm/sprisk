{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "CreateRun": {
      "title": "CreateRun",
      "description": "Request body for POST /runs: run a pipeline version that already passed Gate A.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pipeline_version_id"
      ],
      "properties": {
        "pipeline_version_id": {
          "$ref": "#/$defs/PipelineVersionId"
        }
      }
    },
    "AttemptOutput": {
      "title": "AttemptOutput",
      "description": "One committed output of an attempt: the port that produced it and the artifact.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "port",
        "artifact"
      ],
      "properties": {
        "port": {
          "$ref": "#/$defs/PortName"
        },
        "artifact": {
          "$ref": "#/$defs/Artifact"
        }
      }
    },
    "Problem": {
      "title": "Problem",
      "description": "Error response body. Lists every problem found, not only the first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "errors"
      ],
      "properties": {
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Error"
          }
        }
      }
    },
    "TablePage": {
      "title": "TablePage",
      "description": "One page of rows from a tabular artifact, for display (GET /artifacts/{id}/rows). Cells are display text, cut to a bounded length; a missing cell is listed by column index and its text is empty. Wide tables return only their first columns.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "offset",
        "total_rows",
        "total_columns",
        "columns",
        "rows"
      ],
      "properties": {
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Index of the first row in this page."
        },
        "total_rows": {
          "type": "integer",
          "minimum": 0
        },
        "total_columns": {
          "type": "integer",
          "minimum": 0,
          "description": "Columns in the table; more than `columns` holds when the table is too wide to page whole."
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableColumn"
          }
        },
        "rows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TableRow"
          }
        }
      }
    },
    "TableColumn": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "data_type"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "data_type": {
          "type": "string",
          "description": "Arrow data type name, for display only."
        }
      }
    },
    "TableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "values",
        "missing"
      ],
      "properties": {
        "values": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "missing": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "Indexes of columns whose value is missing in this row."
        }
      }
    },
    "CodeDisplay": {
      "title": "CodeDisplay",
      "description": "What a code step showed (ADR-0020): printed text, tables and images, in order. Written by the worker as the step's display artifact; every part is capped.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items"
      ],
      "properties": {
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DisplayItem"
          }
        }
      }
    },
    "DisplayItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "text",
            "table",
            "image"
          ]
        },
        "text": {
          "type": "string",
          "description": "Present for kind text."
        },
        "table": {
          "$ref": "#/$defs/TablePage",
          "description": "Present for kind table: the first rows only."
        },
        "png_base64": {
          "type": "string",
          "description": "Present for kind image: a PNG, base64-encoded."
        }
      }
    },
    "CodeInterface": {
      "title": "CodeInterface",
      "description": "What a code step's run found about its interface (ADR-0021): names it reads, literal settings it could expose, and values it ends with. Suggestions, not a claim that arbitrary code is understood.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "inputs",
        "parameters",
        "outputs"
      ],
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeInput"
          }
        },
        "parameters": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeParameter"
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/CodeOutputCandidate"
          }
        }
      }
    },
    "CodeInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "origin",
        "bound"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "bound": {
          "type": "boolean",
          "description": "True when the name is provided by the step (its input table or a library); false means the code reads a name nothing defines."
        }
      }
    },
    "CodeParameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "line",
        "value_type",
        "default_text",
        "effective_text",
        "origin"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "line": {
          "type": "integer",
          "minimum": 0
        },
        "value_type": {
          "type": "string",
          "enum": [
            "integer",
            "number",
            "string",
            "boolean"
          ]
        },
        "default_text": {
          "type": "string",
          "description": "The literal as written in the source."
        },
        "effective_text": {
          "type": "string",
          "description": "The literal the run used, as Python source."
        },
        "origin": {
          "$ref": "#/$defs/Origin",
          "description": "inferred until the user exposes it (confirmed)."
        }
      }
    },
    "CodeOutputCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "origin",
        "chosen"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "description": "Python type of the final value, e.g. polars.DataFrame."
        },
        "rows": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "chosen": {
          "type": "boolean",
          "description": "This value became the step's data output."
        }
      }
    }
  }
}
